# Only for a real HTTPS host with a persistent disk
SCENE_DEMO=0
SCENE_DB=/data/scene.db
SCENE_SECURE_COOKIE=1
SCENE_PUBLIC_URL=https://your-domain.example

# Opt-in managed authentication; existing local beta remains the default.
SCENE_AUTH_MODE=local
# Server-only configuration; use a modern publishable key, never a secret key.
SCENE_SUPABASE_PUBLISHABLE_KEY=
# Supabase mode also requires SCENE_SECURE_COOKIE=1 and SCENE_DEMO=0.

# Explicitly opt into deployment validation; never use production mode for demo data.
SCENE_ENV=development
SCENE_TRUSTED_HOSTS=
SCENE_REQUIRE_GUEST_SESSION=0
SCENE_REQUIRE_SUBSCRIPTION=0
# Explicit opt-in for a pilot without charging subscriptions. Authentication,
# PostgreSQL, HTTPS, trusted hosts and guest-session checks remain mandatory.
SCENE_PILOT_WITHOUT_BILLING=0

# Stripe TEST mode only. Supply reviewed price IDs and API version in secure host settings.
# No live-key support is enabled in this release. No charges are made by tests.
SCENE_STRIPE_SECRET_KEY=
SCENE_STRIPE_WEBHOOK_SECRETS=
SCENE_STRIPE_PRICES={}
SCENE_STRIPE_API_VERSION=

# Invitation outbox stays queued until an operator explicitly enables/runs delivery.
SCENE_MAIL_SEND=0
SCENE_RESEND_API_KEY=
SCENE_MAIL_FROM=
